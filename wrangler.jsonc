{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beyxudjs9",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "558e581e-2ea4-46a1-b33b-e3975e367f3e","database_name": "beyxudjs" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "15347fcb4f3041babd111ece62432bd3" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
